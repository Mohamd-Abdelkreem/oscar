generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED

  @@map("user_status")
}

model User {
  id                         String     @id @default(uuid()) @db.Uuid
  email                      String     @unique @db.VarChar(320)
  passwordHash               String     @map("password_hash") @db.VarChar(255)
  fullName                   String     @map("full_name") @db.VarChar(150)
  phone                      String?    @db.VarChar(30)
  role                       UserRole   @default(USER)
  status                     UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt            DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  verificationTokenHash      String?    @map("verification_token_hash") @db.Char(64)
  verificationTokenExpiresAt DateTime?  @map("verification_token_expires_at") @db.Timestamptz(6)
  resetTokenHash             String?    @map("reset_token_hash") @db.Char(64)
  resetTokenExpiresAt        DateTime?  @map("reset_token_expires_at") @db.Timestamptz(6)
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  referralCode               String     @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-'::text, ''::text)")) @map("referral_code") @db.Char(32)
  sponsorUserId              String?    @map("sponsor_user_id") @db.Uuid
  tasksBlocked               Boolean    @default(false) @map("tasks_blocked")
  withdrawalsBlocked         Boolean    @default(false) @map("withdrawals_blocked")
  accountVersion             Int        @default(0) @map("account_version")

  refreshTokens           RefreshToken[]
  wallet                  Wallet?
  financialOperations     FinancialOperation[]  @relation("FinancialActor")
  financialAudits         AuditRecord[]         @relation("AuditActor")
  sponsor                 User?                 @relation("Sponsor", fields: [sponsorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sponsoredUsers          User[]                @relation("Sponsor")
  authSessions            AuthSession[]
  adminSetupState         AdminSetupState?
  issuedInvitations       AdminInvitation[]     @relation("InvitationIssuer")
  acceptedInvitations     AdminInvitation[]     @relation("InvitationAcceptedUser")
  revokedInvitations      AdminInvitation[]     @relation("InvitationRevokedBy")
  identityActorAudits     IdentityAuditRecord[] @relation("IdentityActor")
  identityTargetAudits    IdentityAuditRecord[] @relation("IdentityTarget")
  identityIssuerAudits    IdentityAuditRecord[] @relation("IdentityIssuer")
  updatedPackages         Package[]             @relation("PackageEditor")
  updatedReferralSettings ReferralSettings[]
  configurationChanges    ConfigurationChange[]
  purchaseQuotes          PurchaseQuote[]
  purchases               Purchase[]
  subscriptions           Subscription[]
  referralDecisions       ReferralDecision[]
  createdTasks            Task[]                @relation("TaskCreator")
  updatedTasks            Task[]                @relation("TaskEditor")
  createdTaskCodes        TaskCode[]            @relation("TaskCodeCreator")
  updatedTaskCodes        TaskCode[]            @relation("TaskCodeEditor")
  taskUnlocks             TaskUnlock[]
  imageAssets             ImageAsset[]
  taskSubmissions         TaskSubmission[]
  submissionEvidence      SubmissionEvidence[]  @relation("EvidenceOwner")
  acceptedEvidence        SubmissionEvidence[]  @relation("EvidenceAcceptor")
  reviewedSubmissions     FinalReview[]         @relation("ReviewActor")
  finalReviews            FinalReview[]         @relation("ReviewEmployee")
  taskCommands            TaskCommandRecord[]

  @@index([status, role], map: "users_status_role_idx")
  @@index([sponsorUserId], map: "users_sponsor_idx")
  @@index([role, createdAt, id], map: "users_role_created_id_idx")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sessionId String   @unique @map("session_id") @db.Uuid

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId], map: "refresh_tokens_user_idx")
  @@index([expiresAt], map: "refresh_tokens_expiry_idx")
  @@map("refresh_tokens")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  rememberMe    Boolean        @map("remember_me")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshTokens RefreshToken[]
  imageAssets   ImageAsset[]

  @@unique([id, userId], map: "auth_sessions_id_user_key")
  @@index([userId, revokedAt], map: "auth_sessions_user_revoked_idx")
  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@map("auth_sessions")
}

model AdminSetupState {
  id               Int       @id @default(1)
  firstAdminUserId String?   @unique @map("first_admin_user_id") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  completionSource String?   @map("completion_source") @db.VarChar(32)
  firstAdmin       User?     @relation(fields: [firstAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("admin_setup_state")
}

model AdminInvitation {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique @db.VarChar(320)
  fullName            String                @map("full_name") @db.VarChar(150)
  issuerUserId        String                @map("issuer_user_id") @db.Uuid
  tokenVersion        Int                   @map("token_version")
  tokenHash           String                @unique @map("token_hash") @db.Char(64)
  issuedAt            DateTime              @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime              @map("expires_at") @db.Timestamptz(6)
  acceptedAt          DateTime?             @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId      String?               @map("accepted_user_id") @db.Uuid
  revokedAt           DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId     String?               @map("revoked_by_user_id") @db.Uuid
  revocationReason    String?               @map("revocation_reason") @db.VarChar(500)
  emailAttemptId      String                @map("email_attempt_id") @db.Uuid
  deliveryStatus      String                @default("NOT_ATTEMPTED") @map("delivery_status") @db.VarChar(32)
  emailAttemptedAt    DateTime?             @map("email_attempted_at") @db.Timestamptz(6)
  emailAcknowledgedAt DateTime?             @map("email_acknowledged_at") @db.Timestamptz(6)
  failureCode         String?               @map("failure_code") @db.VarChar(32)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  issuer              User                  @relation("InvitationIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedUser        User?                 @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy           User?                 @relation("InvitationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audits              IdentityAuditRecord[]

  @@index([issuerUserId, acceptedAt, revokedAt], map: "admin_invitations_issuer_disposition_idx")
  @@index([createdAt, id], map: "admin_invitations_created_id_idx")
  @@map("admin_invitations")
}

model IdentityAuditRecord {
  id               String           @id @default(uuid()) @db.Uuid
  occurredAt       DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  action           String           @db.VarChar(32)
  outcome          String           @db.VarChar(16)
  actorKind        String           @map("actor_kind") @db.VarChar(32)
  actorUserId      String?          @map("actor_user_id") @db.Uuid
  operatorIdentity String?          @map("operator_identity") @db.VarChar(160)
  targetUserId     String?          @map("target_user_id") @db.Uuid
  invitationId     String?          @map("invitation_id") @db.Uuid
  issuerUserId     String?          @map("issuer_user_id") @db.Uuid
  tokenVersion     Int?             @map("token_version")
  reason           String?          @db.VarChar(500)
  beforeSnapshot   Json?            @map("before_snapshot")
  afterSnapshot    Json?            @map("after_snapshot")
  actor            User?            @relation("IdentityActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  target           User?            @relation("IdentityTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuer           User?            @relation("IdentityIssuer", fields: [issuerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitation       AdminInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([targetUserId, occurredAt, id], map: "identity_audit_target_time_idx")
  @@index([invitationId, occurredAt, id], map: "identity_audit_invitation_time_idx")
  @@map("identity_audit_records")
}

enum FinancialOperationKind {
  CREDIT
  PURCHASE_DEBIT
  RESERVE
  RELEASE
  CORRECTION

  @@map("financial_operation_kind")
}

enum FinancialOrigin {
  DEPOSIT
  TASK_REWARD
  REFERRAL_COMMISSION
  PACKAGE_PURCHASE
  WITHDRAWAL_RESERVATION
  RESERVATION_RELEASE
  ADMIN_ADJUSTMENT

  @@map("financial_origin")
}

enum FinancialActorType {
  USER
  PROCESS

  @@map("financial_actor_type")
}

enum FundSource {
  NON_REFERRAL
  REFERRAL

  @@map("fund_source")
}

enum ReservationState {
  ACTIVE
  RELEASED

  @@map("reservation_state")
}

model Wallet {
  id                        String   @id @default(uuid()) @db.Uuid
  ownerUserId               String   @unique @map("owner_user_id") @db.Uuid
  availableNonReferralUnits BigInt   @default(0) @map("available_non_referral_units")
  reservedNonReferralUnits  BigInt   @default(0) @map("reserved_non_referral_units")
  availableReferralUnits    BigInt   @default(0) @map("available_referral_units")
  reservedReferralUnits     BigInt   @default(0) @map("reserved_referral_units")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User                    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operations   FinancialOperation[]
  allocations  ReservationAllocation[]
  finalReviews FinalReview[]

  @@unique([id, ownerUserId], map: "wallets_id_owner_key")
  @@map("wallets")
}

model FinancialOperation {
  id                String                 @id @default(uuid()) @db.Uuid
  walletId          String                 @map("wallet_id") @db.Uuid
  kind              FinancialOperationKind
  businessNamespace String                 @map("business_namespace") @db.VarChar(64)
  businessKey       String                 @map("business_key") @db.VarChar(256)
  intentHash        String                 @map("intent_hash") @db.Char(64)
  magnitudeUnits    BigInt                 @map("magnitude_units")
  origin            FinancialOrigin
  actorType         FinancialActorType     @map("actor_type")
  actorUserId       String?                @map("actor_user_id") @db.Uuid
  actorProcessId    String?                @map("actor_process_id") @db.VarChar(64)
  acceptedTerms     Json                   @map("accepted_terms")
  outcome           Json
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet             Wallet                 @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor              User?                  @relation("FinancialActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestIdentities  RequestIdentity[]
  postings           LedgerPosting[]
  openingAllocation  ReservationAllocation? @relation("ReservationOpening")
  releaseAllocation  ReservationAllocation? @relation("ReservationRelease")
  audit              AuditRecord?           @relation("OperationAudit")
  referencedByAudits AuditRecord[]          @relation("CorrectionReference")
  packagePurchase    Purchase?
  referralDecision   ReferralDecision?
  finalReview        FinalReview?

  @@unique([id, walletId])
  @@unique([kind, businessNamespace, businessKey], map: "financial_operations_business_key")
  @@index([walletId], map: "financial_operations_wallet_idx")
  @@map("financial_operations")
}

model RequestIdentity {
  id          String                 @id @default(uuid()) @db.Uuid
  operationId String                 @map("operation_id") @db.Uuid
  actorScope  String                 @map("actor_scope") @db.VarChar(72)
  kind        FinancialOperationKind
  requestKey  String                 @map("request_key") @db.VarChar(128)
  intentHash  String                 @map("intent_hash") @db.Char(64)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  operation FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorScope, kind, requestKey], map: "financial_request_identities_scope_key")
  @@map("financial_request_identities")
}

model LedgerPosting {
  id                  String     @id @default(uuid()) @db.Uuid
  operationId         String     @map("operation_id") @db.Uuid
  walletId            String     @map("wallet_id") @db.Uuid
  source              FundSource
  availableDeltaUnits BigInt     @map("available_delta_units")
  reservedDeltaUnits  BigInt     @map("reserved_delta_units")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  operation FinancialOperation @relation(fields: [operationId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, source], map: "ledger_postings_operation_source_key")
  @@index([walletId], map: "ledger_postings_wallet_idx")
  @@map("ledger_postings")
}

model ReservationAllocation {
  id                 String           @id @default(uuid()) @db.Uuid
  walletId           String           @map("wallet_id") @db.Uuid
  openingOperationId String           @unique @map("opening_operation_id") @db.Uuid
  grossUnits         BigInt           @map("gross_units")
  nonReferralUnits   BigInt           @map("non_referral_units")
  referralUnits      BigInt           @map("referral_units")
  state              ReservationState @default(ACTIVE)
  releaseOperationId String?          @unique @map("release_operation_id") @db.Uuid
  releasedAt         DateTime?        @map("released_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet           Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openingOperation FinancialOperation  @relation("ReservationOpening", fields: [openingOperationId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)
  releaseOperation FinancialOperation? @relation("ReservationRelease", fields: [releaseOperationId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([openingOperationId, walletId])
  @@unique([releaseOperationId, walletId])
  @@index([walletId, state], map: "reservation_allocations_wallet_state_idx")
  @@map("reservation_allocations")
}

model AuditRecord {
  id                   String                 @id @default(uuid()) @db.Uuid
  operationId          String                 @unique @map("operation_id") @db.Uuid
  actorType            FinancialActorType     @map("actor_type")
  actorUserId          String?                @map("actor_user_id") @db.Uuid
  actorProcessId       String?                @map("actor_process_id") @db.VarChar(64)
  action               FinancialOperationKind
  reason               String?                @db.VarChar(500)
  referenceOperationId String?                @map("reference_operation_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  operation          FinancialOperation  @relation("OperationAudit", fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor              User?               @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referenceOperation FinancialOperation? @relation("CorrectionReference", fields: [referenceOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("financial_audit_records")
}

model Package {
  code             String                @id @db.VarChar(2)
  tierOrder        Int                   @unique @map("tier_order")
  priceUnits       BigInt                @map("price_units")
  dailyRewardUnits BigInt                @map("daily_reward_units")
  countedWorkDates Int                   @map("counted_work_dates")
  withdrawalFeeBps Int                   @map("withdrawal_fee_bps")
  version          Int                   @default(1)
  updatedAt        DateTime              @map("updated_at") @db.Timestamptz(6)
  updatedByUserId  String?               @map("updated_by_user_id") @db.Uuid
  updatedBy        User?                 @relation("PackageEditor", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quotes           PurchaseQuote[]
  purchases        Purchase[]
  subscriptions    Subscription[]
  changes          ConfigurationChange[]

  @@map("packages")
}

model ReferralSettings {
  id              Int      @id @default(1)
  version         Int      @default(1)
  level1Bps       Int      @map("level_1_bps")
  level2Bps       Int      @map("level_2_bps")
  level3Bps       Int      @map("level_3_bps")
  level4Bps       Int      @map("level_4_bps")
  level5Bps       Int      @map("level_5_bps")
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(6)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("referral_settings")
}

model ConfigurationChange {
  id               String   @id @default(uuid()) @db.Uuid
  actorUserId      String   @map("actor_user_id") @db.Uuid
  commandId        String   @map("command_id") @db.Uuid
  targetKind       String   @map("target_kind") @db.VarChar(32)
  packageCode      String?  @map("package_code") @db.VarChar(2)
  intentHash       String   @map("intent_hash") @db.Char(64)
  expectedVersion  Int      @map("expected_version")
  committedVersion Int      @map("committed_version")
  reason           String   @db.VarChar(500)
  beforeSnapshot   Json     @map("before_snapshot")
  afterSnapshot    Json     @map("after_snapshot")
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  actor            User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  package          Package? @relation(fields: [packageCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorUserId, commandId], map: "configuration_changes_actor_command_key")
  @@index([targetKind, packageCode, occurredAt, id], map: "configuration_changes_target_time_idx")
  @@map("configuration_changes")
}

model PurchaseQuote {
  id                            String        @id @default(uuid()) @db.Uuid
  buyerId                       String        @map("buyer_id") @db.Uuid
  packageCode                   String        @map("package_code") @db.VarChar(2)
  createdAt                     DateTime      @map("created_at") @db.Timestamptz(6)
  expiresAt                     DateTime      @map("expires_at") @db.Timestamptz(6)
  packageVersion                Int           @map("package_version")
  referralSettingsVersion       Int           @map("referral_settings_version")
  savedRatesBps                 Json          @map("saved_rates_bps")
  expectedBuyerPurchaseSequence BigInt        @map("expected_buyer_purchase_sequence")
  observedSubscriptionId        String?       @map("observed_subscription_id") @db.Uuid
  action                        String        @db.VarChar(16)
  acceptedTerms                 Json          @map("accepted_terms")
  tierOrder                     Int           @map("tier_order")
  priceUnits                    BigInt        @map("price_units")
  dailyRewardUnits              BigInt        @map("daily_reward_units")
  countedWorkDates              Int           @map("counted_work_dates")
  withdrawalFeeBps              Int           @map("withdrawal_fee_bps")
  availableReferralUnits        BigInt        @map("available_referral_units")
  reservedReferralUnits         BigInt        @map("reserved_referral_units")
  availableNonReferralUnits     BigInt        @map("available_non_referral_units")
  reservedNonReferralUnits      BigInt        @map("reserved_non_referral_units")
  fullDebitUnits                BigInt        @map("full_debit_units")
  usableUnits                   BigInt        @map("usable_units")
  topUpUnits                    BigInt        @map("top_up_units")
  fundedReferralUnits           BigInt        @map("funded_referral_units")
  fundedNonReferralUnits        BigInt        @map("funded_non_referral_units")
  firstWorkDate                 DateTime      @map("first_work_date") @db.Date
  finalWorkDate                 DateTime      @map("final_work_date") @db.Date
  subscriptionExpiresAt         DateTime      @map("subscription_expires_at") @db.Timestamptz(6)
  intentHash                    String        @map("intent_hash") @db.Char(64)
  buyer                         User          @relation(fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  package                       Package       @relation(fields: [packageCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  observedSubscription          Subscription? @relation("QuoteObservedSubscription", fields: [observedSubscriptionId, buyerId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict)
  purchase                      Purchase?

  @@unique([id, buyerId], map: "purchase_quotes_id_buyer_key")
  @@index([buyerId, createdAt, id], map: "purchase_quotes_buyer_time_idx")
  @@map("purchase_quotes")
}

model Purchase {
  id                      String             @id @default(uuid()) @db.Uuid
  quoteId                 String             @unique @map("quote_id") @db.Uuid
  buyerId                 String             @map("buyer_id") @db.Uuid
  buyerSequence           BigInt             @map("buyer_sequence")
  action                  String             @db.VarChar(16)
  packageCode             String             @map("package_code") @db.VarChar(2)
  previousSubscriptionId  String?            @map("previous_subscription_id") @db.Uuid
  debitOperationId        String             @unique @map("debit_operation_id") @db.Uuid
  purchasedAt             DateTime           @map("purchased_at") @db.Timestamptz(6)
  acceptedTerms           Json               @map("accepted_terms")
  tierOrder               Int                @map("tier_order")
  priceUnits              BigInt             @map("price_units")
  dailyRewardUnits        BigInt             @map("daily_reward_units")
  countedWorkDates        Int                @map("counted_work_dates")
  withdrawalFeeBps        Int                @map("withdrawal_fee_bps")
  packageVersion          Int                @map("package_version")
  fullDebitUnits          BigInt             @map("full_debit_units")
  sourceReferralUnits     BigInt             @map("source_referral_units")
  sourceNonReferralUnits  BigInt             @map("source_non_referral_units")
  commissionBaseUnits     BigInt             @map("commission_base_units")
  referralSettingsVersion Int                @map("referral_settings_version")
  savedRatesBps           Json               @map("saved_rates_bps")
  buyer                   User               @relation(fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  package                 Package            @relation(fields: [packageCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  quote                   PurchaseQuote      @relation(fields: [quoteId, buyerId], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  previousSubscription    Subscription?      @relation("PurchasePreviousSubscription", fields: [previousSubscriptionId, buyerId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict)
  debitOperation          FinancialOperation @relation(fields: [debitOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscription            Subscription?      @relation("SubscriptionPurchase")
  replacedSubscriptions   Subscription[]     @relation("SubscriptionReplacement")
  decisions               ReferralDecision[]

  @@unique([buyerId, buyerSequence], map: "purchases_buyer_sequence_key")
  @@unique([quoteId, buyerId], map: "purchases_quote_buyer_key")
  @@unique([id, buyerId], map: "purchases_id_buyer_key")
  @@index([buyerId, purchasedAt, id], map: "purchases_buyer_time_idx")
  @@map("purchases")
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  ownerUserId           String             @map("owner_user_id") @db.Uuid
  purchaseId            String             @unique @map("purchase_id") @db.Uuid
  packageCode           String             @map("package_code") @db.VarChar(2)
  acceptedTerms         Json               @map("accepted_terms")
  tierOrder             Int                @map("tier_order")
  priceUnits            BigInt             @map("price_units")
  dailyRewardUnits      BigInt             @map("daily_reward_units")
  countedWorkDates      Int                @map("counted_work_dates")
  withdrawalFeeBps      Int                @map("withdrawal_fee_bps")
  packageVersion        Int                @map("package_version")
  activationAt          DateTime           @map("activation_at") @db.Timestamptz(6)
  firstWorkDate         DateTime           @map("first_work_date") @db.Date
  finalWorkDate         DateTime           @map("final_work_date") @db.Date
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz(6)
  state                 String             @default("CURRENT") @db.VarChar(16)
  replacedAt            DateTime?          @map("replaced_at") @db.Timestamptz(6)
  replacementPurchaseId String?            @map("replacement_purchase_id") @db.Uuid
  owner                 User               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  package               Package            @relation(fields: [packageCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  purchase              Purchase           @relation("SubscriptionPurchase", fields: [purchaseId, ownerUserId], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  replacementPurchase   Purchase?          @relation("SubscriptionReplacement", fields: [replacementPurchaseId, ownerUserId], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  observedByQuotes      PurchaseQuote[]    @relation("QuoteObservedSubscription")
  previousForPurchases  Purchase[]         @relation("PurchasePreviousSubscription")
  referralDecisions     ReferralDecision[]
  taskSubmissions       TaskSubmission[]

  @@unique([id, ownerUserId], map: "subscriptions_id_owner_key")
  @@unique([purchaseId, ownerUserId], map: "subscriptions_purchase_owner_key")
  @@index([ownerUserId, activationAt, id], map: "subscriptions_owner_activation_idx")
  @@index([packageCode, state, expiresAt], map: "subscriptions_package_state_expiry_idx")
  @@map("subscriptions")
}

model ReferralDecision {
  id                      String              @id @default(uuid()) @db.Uuid
  purchaseId              String              @map("purchase_id") @db.Uuid
  recipientUserId         String              @map("recipient_user_id") @db.Uuid
  level                   Int
  decision                String              @db.VarChar(16)
  skippedReason           String?             @map("skipped_reason") @db.VarChar(32)
  zeroReason              String?             @map("zero_reason") @db.VarChar(32)
  rateBps                 Int                 @map("rate_bps")
  commissionBaseUnits     BigInt              @map("commission_base_units")
  awardUnits              BigInt              @map("award_units")
  recipientSubscriptionId String?             @map("recipient_subscription_id") @db.Uuid
  eligibilitySnapshot     Json                @map("eligibility_snapshot")
  creditOperationId       String?             @unique @map("credit_operation_id") @db.Uuid
  occurredAt              DateTime            @map("occurred_at") @db.Timestamptz(6)
  purchase                Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient               User                @relation(fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipientSubscription   Subscription?       @relation(fields: [recipientSubscriptionId, recipientUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict)
  creditOperation         FinancialOperation? @relation(fields: [creditOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([purchaseId, recipientUserId, level], map: "referral_decisions_award_key")
  @@unique([purchaseId, level], map: "referral_decisions_purchase_level_key")
  @@index([recipientUserId, occurredAt, id], map: "referral_decisions_recipient_time_idx")
  @@map("referral_decisions")
}

enum TaskPublicationState {
  PUBLISHED
  PAUSED
  CLOSED

  @@map("task_publication_state")
}

enum TaskCodeState {
  ENABLED
  PAUSED

  @@map("task_code_state")
}

enum ImageAssetPurpose {
  PROOF
  TASK_ILLUSTRATION

  @@map("image_asset_purpose")
}

enum ImageAssetState {
  STAGING
  READY
  FAILED
  DELETING
  DELETED

  @@map("image_asset_state")
}

enum TaskSubmissionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("task_submission_status")
}

enum TaskCommandKind {
  TASK_CREATE
  TASK_EDIT
  TASK_STATUS
  CODE_CREATE
  CODE_STATUS
  TASK_UNLOCK
  SUBMISSION_CREATE
  EVIDENCE_REPLACE
  FINAL_REVIEW

  @@map("task_command_kind")
}

enum TaskCommandTerminalState {
  COMMITTED
  CANCELLED

  @@map("task_command_terminal_state")
}

model Task {
  id                   String               @id @default(uuid()) @db.Uuid
  publicationDate      DateTime             @unique(map: "tasks_publication_date_key") @map("publication_date") @db.Date
  publicationState     TaskPublicationState @map("publication_state")
  revision             Int                  @default(1)
  firstParticipationAt DateTime?            @map("first_participation_at") @db.Timestamptz(6)
  title                String               @db.VarChar(150)
  description          String               @db.VarChar(10000)
  targetUrl            String               @map("target_url") @db.VarChar(2000)
  platform             String               @db.VarChar(80)
  illustrationAssetId  String?              @map("illustration_asset_id") @db.Uuid
  illustrationPurpose  ImageAssetPurpose?   @map("illustration_purpose")
  isCodeRequired       Boolean              @map("is_code_required")
  createdAt            DateTime             @map("created_at") @db.Timestamptz(6)
  createdByUserId      String               @map("created_by_user_id") @db.Uuid
  updatedAt            DateTime             @map("updated_at") @db.Timestamptz(6)
  updatedByUserId      String               @map("updated_by_user_id") @db.Uuid
  creator              User                 @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  editor               User                 @relation("TaskEditor", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  illustration         ImageAsset?          @relation(fields: [illustrationAssetId, illustrationPurpose], references: [id, purpose], onDelete: Restrict, onUpdate: Restrict)
  codes                TaskCode[]
  unlocks              TaskUnlock[]
  submissions          TaskSubmission[]
  commands             TaskCommandRecord[]

  @@unique([id, publicationDate], map: "tasks_id_date_key")
  @@index([publicationDate, id], map: "tasks_date_id_idx")
  @@map("tasks")
}

model TaskCode {
  id              String              @id @default(uuid()) @db.Uuid
  taskId          String              @map("task_id") @db.Uuid
  normalizedText  String              @unique(map: "task_codes_normalized_text_key") @map("normalized_text") @db.VarChar(64)
  state           TaskCodeState
  version         Int                 @default(1)
  description     String?             @db.VarChar(500)
  createdAt       DateTime            @map("created_at") @db.Timestamptz(6)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  updatedAt       DateTime            @map("updated_at") @db.Timestamptz(6)
  updatedByUserId String              @map("updated_by_user_id") @db.Uuid
  task            Task                @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator         User                @relation("TaskCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  editor          User                @relation("TaskCodeEditor", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unlocks         TaskUnlock[]
  commands        TaskCommandRecord[]

  @@unique([id, taskId], map: "task_codes_id_task_key")
  @@index([taskId, state, id], map: "task_codes_task_state_id_idx")
  @@map("task_codes")
}

model TaskUnlock {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  codeId       String   @map("code_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  unlockedAt   DateTime @map("unlocked_at") @db.Timestamptz(6)
  employee     User     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task         Task     @relation(fields: [taskId, businessDate], references: [id, publicationDate], onDelete: Restrict, onUpdate: Restrict)
  code         TaskCode @relation(fields: [codeId, taskId], references: [id, taskId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, taskId, businessDate], map: "task_unlocks_employee_task_date_key")
  @@index([codeId, unlockedAt, id], map: "task_unlocks_code_time_idx")
  @@index([employeeId, businessDate, id], map: "task_unlocks_employee_date_idx")
  @@map("task_unlocks")
}

model ImageAsset {
  id                       String               @id @default(uuid()) @db.Uuid
  ownerUserId              String               @map("owner_user_id") @db.Uuid
  purpose                  ImageAssetPurpose
  uploadCommandId          String               @map("upload_command_id") @db.Uuid
  uploadIntentHash         String?              @map("upload_intent_hash") @db.Char(64)
  state                    ImageAssetState
  receivedAt               DateTime?            @map("received_at") @db.Timestamptz(6)
  uploadedBySessionId      String?              @map("uploaded_by_session_id") @db.Uuid
  processingLeaseId        String?              @map("processing_lease_id") @db.Uuid
  processingLeaseExpiresAt DateTime?            @map("processing_lease_expires_at") @db.Timestamptz(6)
  uploadedAt               DateTime?            @map("uploaded_at") @db.Timestamptz(6)
  readyAt                  DateTime?            @map("ready_at") @db.Timestamptz(6)
  storageKey               String?              @unique(map: "image_assets_storage_key_key") @map("storage_key") @db.VarChar(128)
  inputByteCount           Int?                 @map("input_byte_count")
  storedByteCount          Int?                 @map("stored_byte_count")
  format                   String?              @db.VarChar(8)
  width                    Int?
  height                   Int?
  contentHash              String?              @map("content_hash") @db.Char(64)
  failureCode              String?              @map("failure_code") @db.VarChar(40)
  failedAt                 DateTime?            @map("failed_at") @db.Timestamptz(6)
  deletionLeaseId          String?              @map("deletion_lease_id") @db.Uuid
  deletionLeaseExpiresAt   DateTime?            @map("deletion_lease_expires_at") @db.Timestamptz(6)
  deletedAt                DateTime?            @map("deleted_at") @db.Timestamptz(6)
  owner                    User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadSession            AuthSession?         @relation(fields: [uploadedBySessionId, ownerUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  illustratedTasks         Task[]
  evidence                 SubmissionEvidence[]

  @@unique([ownerUserId, purpose, uploadCommandId], map: "image_assets_owner_purpose_upload_key")
  @@unique([id, ownerUserId, purpose], map: "image_assets_id_owner_purpose_key")
  @@unique([id, purpose], map: "image_assets_id_purpose_key")
  @@index([purpose, state, uploadedAt, id], map: "image_assets_retention_idx")
  @@index([state, deletionLeaseExpiresAt, id], map: "image_assets_deletion_lease_idx")
  @@map("image_assets")
}

model TaskSubmission {
  id                        String               @id @default(uuid()) @db.Uuid
  employeeId                String               @map("employee_id") @db.Uuid
  taskId                    String               @map("task_id") @db.Uuid
  businessDate              DateTime             @map("business_date") @db.Date
  capturedTaskRevision      Int                  @map("captured_task_revision")
  capturedTaskContent       Json                 @map("captured_task_content")
  subscriptionId            String               @map("subscription_id") @db.Uuid
  capturedSubscriptionTerms Json                 @map("captured_subscription_terms")
  rewardUnits               BigInt               @map("reward_units")
  executionDeclared         Boolean              @map("execution_declared")
  submittedAt               DateTime             @map("submitted_at") @db.Timestamptz(6)
  deadlineAt                DateTime             @map("deadline_at") @db.Timestamptz(6)
  status                    TaskSubmissionStatus @default(PENDING)
  version                   Int                  @default(1)
  currentEvidenceVersion    Int                  @map("current_evidence_version")
  employee                  User                 @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task                      Task                 @relation(fields: [taskId, businessDate], references: [id, publicationDate], onDelete: Restrict, onUpdate: Restrict)
  subscription              Subscription         @relation(fields: [subscriptionId, employeeId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict)
  evidence                  SubmissionEvidence[]
  finalReview               FinalReview?
  commands                  TaskCommandRecord[]

  // SQL owns the deferred (id, current_evidence_version) evidence reference.
  @@unique([employeeId, businessDate], map: "task_submissions_employee_date_key")
  @@unique([id, employeeId], map: "task_submissions_id_employee_key")
  @@unique([id, taskId, businessDate], map: "task_submissions_id_task_date_key")
  @@index([status, submittedAt, id], map: "task_submissions_status_time_idx")
  @@index([taskId, status, submittedAt, id], map: "task_submissions_task_status_time_idx")
  @@index([employeeId, submittedAt, id], map: "task_submissions_employee_time_idx")
  @@map("task_submissions")
}

model SubmissionEvidence {
  id               String            @id @default(uuid()) @db.Uuid
  submissionId     String            @map("submission_id") @db.Uuid
  employeeId       String            @map("employee_id") @db.Uuid
  version          Int
  assetId          String            @map("asset_id") @db.Uuid
  assetPurpose     ImageAssetPurpose @map("asset_purpose")
  acceptedAt       DateTime          @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String            @map("accepted_by_user_id") @db.Uuid
  submission       TaskSubmission    @relation(fields: [submissionId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Restrict)
  employee         User              @relation("EvidenceOwner", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy       User              @relation("EvidenceAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset            ImageAsset        @relation(fields: [assetId, employeeId, assetPurpose], references: [id, ownerUserId, purpose], onDelete: Restrict, onUpdate: Restrict)
  finalReviews     FinalReview[]

  @@unique([submissionId, version], map: "submission_evidence_submission_version_key")
  @@index([assetId, submissionId], map: "submission_evidence_asset_submission_idx")
  @@map("submission_evidence")
}

model FinalReview {
  id                  String               @id @default(uuid()) @db.Uuid
  submissionId        String               @unique(map: "final_reviews_submission_key") @map("submission_id") @db.Uuid
  employeeId          String               @map("employee_id") @db.Uuid
  decision            TaskSubmissionStatus
  submissionVersion   Int                  @map("submission_version")
  evidenceVersion     Int                  @map("evidence_version")
  actorUserId         String               @map("actor_user_id") @db.Uuid
  decidedAt           DateTime             @map("decided_at") @db.Timestamptz(6)
  reason              String               @db.VarChar(500)
  walletId            String?              @map("wallet_id") @db.Uuid
  approvalOperationId String?              @unique(map: "final_reviews_approval_operation_key") @map("approval_operation_id") @db.Uuid
  submission          TaskSubmission       @relation(fields: [submissionId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Restrict)
  employee            User                 @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor               User                 @relation("ReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evidence            SubmissionEvidence   @relation(fields: [submissionId, evidenceVersion], references: [submissionId, version], onDelete: Restrict, onUpdate: Restrict)
  wallet              Wallet?              @relation(fields: [walletId, employeeId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict)
  operation           FinancialOperation?  @relation(fields: [approvalOperationId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([submissionId, employeeId], map: "final_reviews_submission_employee_key")
  @@unique([approvalOperationId, walletId], map: "final_reviews_operation_wallet_key")
  @@map("final_reviews")
}

model TaskCommandRecord {
  id             String                   @id @default(uuid()) @db.Uuid
  actorUserId    String                   @map("actor_user_id") @db.Uuid
  kind           TaskCommandKind
  commandId      String                   @map("command_id") @db.Uuid
  terminalState  TaskCommandTerminalState @map("terminal_state")
  intentHash     String?                  @map("intent_hash") @db.Char(64)
  taskId         String?                  @map("task_id") @db.Uuid
  codeId         String?                  @map("code_id") @db.Uuid
  submissionId   String?                  @map("submission_id") @db.Uuid
  occurredAt     DateTime                 @map("occurred_at") @db.Timestamptz(6)
  reason         String?                  @db.VarChar(500)
  beforeSnapshot Json?                    @map("before_snapshot")
  afterSnapshot  Json?                    @map("after_snapshot")
  safeOutcome    Json?                    @map("safe_outcome")
  actor          User                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task           Task?                    @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code           TaskCode?                @relation(fields: [codeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submission     TaskSubmission?          @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorUserId, kind, commandId], map: "task_commands_actor_kind_command_key")
  @@index([actorUserId, occurredAt, id], map: "task_commands_actor_time_idx")
  @@index([codeId, occurredAt, id], map: "task_commands_code_time_idx")
  @@map("task_command_records")
}
