NODE_ENV=development
APP_NAME=Full-Stack Boilerplate API
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://boilerplate:local_development_only@localhost:5432/boilerplate?schema=public
LOG_LEVEL=debug
TRUST_PROXY=false
BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=31000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
# Private proof storage must be separate from the project and public/static roots.
# Requires filesystem containment, private permissions and directory fsync.
# Required absolute directory outside the project tree; no default or public mount.
PROOF_STORAGE_ROOT=
# Per-process admission: 1..2 uploads, held through parser/child/cleanup completion.
PROOF_PROCESSING_SLOTS=2
# Temporary/reserved bytes only: slots * 41943040 minimum, 268435456 maximum.
# Accepted files need separately provisioned persistent capacity and backups.
PROOF_STAGING_MAX_BYTES=268435456
# Multipart input deadline: 1..30000 ms, shortened by a stricter request deadline.
PROOF_INPUT_DEADLINE_MS=30000
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=boilerplate
POSTGRES_PORT=5432

# Authentication. Replace every secret before deployment.
AUTH_JWT_SECRET=
AUTH_REFRESH_JWT_SECRET=
AUTH_VERIFICATION_JWT_SECRET=
AUTH_RESET_JWT_SECRET=
AUTH_JWT_ISSUER=full-stack-boilerplate
AUTH_JWT_AUDIENCE=full-stack-boilerplate-web
AUTH_JWT_CLOCK_TOLERANCE_SECONDS=5
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_FAMILY_TTL_SECONDS=86400
AUTH_REFRESH_REMEMBERED_TTL_SECONDS=2592000
AUTH_VERIFY_TOKEN_TTL_SECONDS=86400
AUTH_RESET_TOKEN_TTL_SECONDS=1800
AUTH_VERIFY_RESEND_COOLDOWN_SECONDS=60
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_COOKIE_SAME_SITE=lax

# Authentication route limits.
AUTH_LIMIT_REGISTER_PER_HOUR=5
AUTH_LIMIT_VERIFY_PER_15_MIN=20
AUTH_LIMIT_VERIFY_TOKEN_MAX_ATTEMPTS=5
AUTH_LIMIT_RESEND_PER_HOUR_SOURCE=20
AUTH_LIMIT_RESEND_PER_HOUR_ACCOUNT=5
AUTH_LIMIT_LOGIN_PER_15_MIN=20
AUTH_LIMIT_LOGIN_PER_15_MIN_ACCOUNT=5
AUTH_LIMIT_REFRESH_PER_15_MIN=60
AUTH_LIMIT_FORGOT_PER_HOUR_SOURCE=20
AUTH_LIMIT_FORGOT_PER_HOUR_ACCOUNT=5
AUTH_LIMIT_RESET_PER_15_MIN=20
AUTH_LIMIT_RESET_TOKEN_MAX_ATTEMPTS=5
AUTH_LIMIT_PASSWORD_CHANGE_PER_15_MIN=5
AUTH_LIMIT_LOGOUT_PER_15_MIN=30
AUTH_LIMIT_LOGOUT_ALL_PER_15_MIN=5
AUTH_LIMIT_ADMIN_CONTROL_PER_15_MIN=30
AUTH_LIMIT_INVITATION_PER_15_MIN=20
AUTH_LIMIT_INVITATION_TOKEN_MAX_ATTEMPTS=5
AUTH_LIMIT_INVITATION_PER_HOUR_ACTOR=5
AUTH_LIMIT_INVITATION_PER_HOUR_RECIPIENT=5

# Transactional email. Production requires Resend and explicit company settings.
# For local use, set EMAIL_PROVIDER=console and WEB_APP_URL=http://localhost:3000.
EMAIL_PROVIDER=
RESEND_API_KEY=
WEB_APP_URL=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
# Required production destination, configured only after owner surface approval.
ADMIN_INVITATION_ACCEPT_URL=
# Exact WEB_APP_URL origin + /employee/account; HTTPS is required in production.
WITHDRAWAL_ADDRESS_CONFIRM_URL=http://localhost:3000/employee/account
WITHDRAWAL_ADDRESS_TOKEN_TTL_SECONDS=1800
WITHDRAWAL_ADDRESS_RESEND_COOLDOWN_SECONDS=60
WITHDRAWAL_QUOTE_TTL_SECONDS=600
# API producer and withdrawal scheduling worker; explicit connection, no runtime fallback.
WITHDRAWAL_REDIS_URL=redis://127.0.0.1:6379/0
WITHDRAWAL_REDIS_PORT=6379
WITHDRAWAL_QUEUE_PREFIX=oscar-withdrawals
WITHDRAWAL_SCAN_BATCH_SIZE=50
WITHDRAWAL_SCAN_INTERVAL_MS=30000
WITHDRAWAL_PRODUCER_TIMEOUT_MS=2000
WITHDRAWAL_JOB_ATTEMPTS=3
WITHDRAWAL_JOB_RETRY_DELAY_MS=1000
WITHDRAWAL_RETAINED_JOBS=1000
# Signer PostgreSQL discovery; no Redis connection is loaded by the signer.
WITHDRAWAL_PAYOUT_SCAN_INTERVAL_MS=1000
WITHDRAWAL_PAYOUT_REPAIR_INTERVAL_MS=30000
WITHDRAWAL_PAYOUT_SCAN_BATCH_SIZE=20
# Diagnostic age from saved dispatch time; integer 1000-86400000, independent of reminders.
WITHDRAWAL_PENDING_ALERT_AFTER_MS=300000
# CLI-only explicit nonroot Linux UID; no effect on ordinary API startup.
ADMIN_BOOTSTRAP_OPERATOR_UID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_SELF_SIGNED_TLS=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_TLS_MIN_VERSION=TLSv1.2

# P06 process-scoped configuration. No boot UUID or acknowledgement is read from env.
# API public metadata; never add NEXT_PUBLIC custody/provider credentials.
TRON_NETWORK=
TRON_TOKEN_CONTRACT=
# Worker/signer provider identity. Canonical genesis/token decimals are verified before work.
TRON_EXPECTED_GENESIS_BLOCK_ID=
TRON_PROVIDER_URL=
# API_KEY is the default. PUBLIC_TESTNET requires Nile/Shasta and either
# P06_TESTNET_OPT_IN=YES or OSCAR_TESTNET_PROFILE=P08_PAYOUT + P08_TESTNET_OPT_IN=YES.
TRON_PROVIDER_AUTH=API_KEY
TRON_PROVIDER_API_KEY_FILE=
TRON_PROVIDER_TIMEOUT_MS=10000
TRON_MAX_RESPONSE_BYTES=2097152
TRON_DISCOVERY_PAGE_SIZE=100
TRON_PAGES_PER_ADDRESS=5
TRON_CANDIDATE_BATCH_SIZE=50
TRON_CONCURRENT_READS=4
TRON_MAX_ATTEMPTS=3
TRON_SCAN_LAG_ALERT_AFTER_MS=300000
TRON_PENDING_WORK_ALERT_AFTER_MS=300000
# Signer-only fixed treasury and exact integer USDT/SUN budgets; no live defaults.
TRON_TREASURY_ADDRESS=
TRON_MAX_SWEEP_UNITS=
TRON_PAYOUT_KEY_ID=
TRON_MAX_PAYOUT_UNITS=
TRON_PAYOUT_ENERGY_FEE_LIMIT_SUN=
TRON_PAYOUT_MAX_COMPANY_COST_SUN=
TRON_ENERGY_FEE_LIMIT_SUN=
TRON_MAX_COMPANY_COST_SUN=
TRON_MAX_MANUAL_FUNDING_SUN=
# Signer-only absolute existing private files/directories, outside source/proof storage.
CUSTODY_KEY_FILE=
CUSTODY_KEY_ID=
CUSTODY_RETAINED_KEYS_FILE=
CUSTODY_STORAGE_ROOT=
CUSTODY_SSH_CONFIG_FILE=
CUSTODY_SSH_KNOWN_HOSTS_FILE=
CUSTODY_RECOVERY_HOST=
CUSTODY_OPERATOR_IDENTITY=
# Protected operator: independently retained recovered DB history manifest, outside the project.
CUSTODY_FINANCIAL_HISTORY_FILE=
# Independent helper ciphertext root; separately scoped recovery operator decryption file.
CUSTODY_RECOVERY_STORAGE_ROOT=
CUSTODY_RECOVERY_KEY_FILE=
# Required separate live-test opt-in; configuration does not authorize transfers.
P06_TESTNET_OPT_IN=false
# Payout-only live test profile. Leave disabled outside a separately authorized run.
# Private inputs must be absolute Linux paths outside the project/proof storage.
OSCAR_TESTNET_PROFILE=P06
P08_TESTNET_OPT_IN=NO
P08_TESTNET_APPROVAL_REFERENCE=
P08_TESTNET_ISOLATED=NO
P08_TESTNET_FUNDING_CONFIRMED=NO
P08_TESTNET_RESOURCES_CONFIRMED=NO
P08_TESTNET_WITHDRAWAL_ID=
P08_TESTNET_RECIPIENT=
P08_TESTNET_GROSS_UNITS=
P08_TESTNET_NET_UNITS=
P08_TESTNET_SIGNER_DATABASE_FILE=
P08_TESTNET_OPERATOR_DATABASE_FILE=
P08_TESTNET_RECOVERED_STORAGE_ROOT=
# Optional recovery-only mode: omit unless resuming the designated UNKNOWN attempt.
# P08_TESTNET_ORIGINAL_TRANSACTION_ID=<original nonzero lowercase 64-hex TxID>

# Optional local-only administrator seed. Set all three together.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_NAME=Local Administrator
# SEED_ADMIN_PASSWORD=

# Optional local-only user seed. Set all three together.
# SEED_USER_EMAIL=user@example.com
# SEED_USER_NAME=Local User
# SEED_USER_PASSWORD=
