{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "sourceMap": true,
    "inlineSources": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "tests",
    "src/modules/ledger/testing/**",
    "src/modules/auth/testing/**",
    "src/modules/subscriptions/testing/**",
    "src/modules/tasks/testing/**",
    "src/modules/task-submissions/testing/**",
    "src/modules/proofs/testing/**",
    "src/modules/custody/testing/**",
    "src/modules/deposits/testing/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/modules/treasury/testing/**",
    "src/modules/withdrawals/testing/**"
  ]
}
